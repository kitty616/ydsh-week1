{
  "ydsh_ads.ads_kpi_core": {
    "table": "ads_kpi_core",
    "db": "ydsh_ads",
    "description": "核心 KPI 指标长表，每个指标一行，含口径说明",
    "columns": [
      {
        "name": "metric_code",
        "type": "string",
        "comment": "指标编码，如 KPI_GMV"
      },
      {
        "name": "metric_name",
        "type": "string",
        "comment": "指标中文名，如 GMV 成交总额"
      },
      {
        "name": "metric_value",
        "type": "double",
        "comment": "指标值（数值）"
      },
      {
        "name": "unit",
        "type": "string",
        "comment": "单位"
      },
      {
        "name": "calc_rule",
        "type": "string",
        "comment": "计算口径说明"
      }
    ]
  },
  "ydsh_ads.ads_sales_daily_report": {
    "table": "ads_sales_daily_report",
    "db": "ydsh_ads",
    "description": "销售日报，每天一行，含环比与 7 日移动平均",
    "columns": [
      {
        "name": "dt",
        "type": "string",
        "comment": "日期 yyyy-MM-dd"
      },
      {
        "name": "gmv",
        "type": "double",
        "comment": "当日成交总额（元）"
      },
      {
        "name": "order_cnt",
        "type": "bigint",
        "comment": "当日订单量"
      },
      {
        "name": "user_cnt",
        "type": "bigint",
        "comment": "当日下单用户数"
      },
      {
        "name": "aov",
        "type": "double",
        "comment": "当日客单价（元/单）"
      },
      {
        "name": "dod_rate",
        "type": "double",
        "comment": "GMV 日环比（小数）"
      },
      {
        "name": "wow_rate",
        "type": "double",
        "comment": "GMV 周同比（对 7 天前，小数）"
      },
      {
        "name": "ma7_gmv",
        "type": "double",
        "comment": "近 7 日 GMV 移动平均"
      }
    ]
  },
