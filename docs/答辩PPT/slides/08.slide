<Slide style={{ width: '1280px', height: '720px', padding: '60px', background: '#FFFFFF', flexDirection: 'column' }}>
    <Box style={{ width: '100%', height: 22, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#3D7BD9', letterSpacing: 1.5 }}>02 · 架构与数据</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>云购生活 · 第 5 周综合答辩</Text>
    </Box>

    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.25, marginTop: 6 }}>数据治理：99.73% 是修出来的，不是算出来的</Text>

    <Box style={{ width: '100%', height: 1, background: '#D6DCE5', marginTop: 10, marginBottom: 18 }} />

    <Box style={{ flex: 1, width: '100%', flexDirection: 'row', gap: 36 }}>
        <Box style={{ width: 620, flexDirection: 'column' }}>
            <Text style={{ fontSize: 16, color: '#4A5568', marginBottom: 10 }}>五类脏数据 · 修复前 → 修复后</Text>
            <Table
                style={{ width: '100%', height: 268 }}
                defaultTextStyle={{ fontSize: 15, color: '#1A2230', textAlign: 'left' }}
                defaultCellStyle={{
                    border: {
                        left: { width: 1, color: '#E5E7EB' },
                        right: { width: 1, color: '#E5E7EB' },
                        top: { width: 1, color: '#E5E7EB' },
                        bottom: { width: 1, color: '#E5E7EB' },
                    },
                    padding: { top: 9, bottom: 9, left: 12, right: 12 },
                }}
                cells={[
                    [
                        { text: '脏数据类型', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                        { text: '清洗前', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                        { text: '清洗后', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                        { text: '修复率', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1E4FA8' } } },
                    ],
                    ['枚举不规范', '60,422', '0', '100.00%'],
                    [
                        { text: '格式不统一', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '8,217', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '0', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '100.00%', cellStyle: { background: { color: '#F7F9FC' } } },
                    ],
                    ['异常值', '1,387', '0', '100.00%'],
                    [
                        { text: '重复值', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '600', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '0', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '100.00%', cellStyle: { background: { color: '#F7F9FC' } } },
                    ],
                    [
                        { text: '缺失值', textStyle: { color: '#D9534F' } },
                        { text: '353', textStyle: { color: '#D9534F' } },
                        { text: '193', textStyle: { color: '#D9534F' } },
                        { text: '45.33%', textStyle: { color: '#D9534F', bold: true } },
                    ],
                    [
                        { text: '合计', textStyle: { bold: true } },
                        { text: '70,979', textStyle: { bold: true } },
                        { text: '193', textStyle: { bold: true } },
                        { text: '99.73%', textStyle: { bold: true, color: '#0E3F8C' } },
                    ],
                ]}
            />
        </Box>

        <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
            <Text style={{ fontSize: 16, color: '#4A5568' }}>三个判断，比一个百分比更重要</Text>

            <Box style={{ padding: '14px 16px', background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 4, flexDirection: 'column' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>不是所有脏数据都该修</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5, marginTop: 6 }}>193 条邮箱缺失是有意保留的：弱依赖字段，打标记位即可，编造邮箱比空值更危险。</Text>
            </Box>

            <Box style={{ padding: '14px 16px', background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 4, flexDirection: 'column' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>行级修复率会骗人</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5, marginTop: 6 }}>补一个「订单完整率」= 14,259 ÷ 14,398 = 99.03%：清洗后仍有有效明细的订单占比。</Text>
            </Box>

            <Box style={{ padding: '14px 16px', background: '#F0F5FC', border: '1px solid #3D7BD9', borderRadius: 4, flexDirection: 'column' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>正因为它，才抓到了 0.97%</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5, marginTop: 6 }}>139 笔订单明细被整单剔除，金额 34.96 万元——正是这一项指标提前预警了缺口。</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ width: '100%', height: 16, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginTop: 8 }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>云购生活数据仓库项目组</Text>
        <Text style={{ fontSize: 14, color: '#0E3F8C' }}>08</Text>
    </Box>
</Slide>
